# Release packaging for Wing It.
#
# Add this as the LAST line of the top-level CMakeLists.txt (after the wing_it
# target and every FetchContent dependency), and remove any install(...) or
# include(CPack) lines added earlier:
#
#     include(packaging/packaging.cmake)
#
# What it does:
#   - Builds the logo into the executable, so the game can set it as the window /
#     taskbar icon (wingit::SetWindowLogo() in app_icon.hpp).
#   - Windows: logo becomes the .exe's icon in Explorer; Release builds open
#     without a console window behind the game.
#   - "cpack" makes a package that contains ONLY the game. raylib, glm, json, etc.
#     have their own install rules (headers, .a/.lib files, CMake configs), which
#     is what filled the old package with "random project stuff"; they are left out.
#
#       Windows  WingIt-Windows.zip   -> Wing It.exe  (+ the MSVC runtime DLLs it needs)
#       macOS    WingIt-macOS.zip     -> Wing It.app  (logo as app icon, libomp bundled inside)
#       Linux    WingIt-Linux.tar.gz  -> WingIt
#
#   - Folders the game reads at runtime are copied in next to the executable
#     (inside the .app on macOS). Any of assets/, resources/, res/ or data/ that
#     exist are picked up automatically; to choose them yourself, set e.g.
#         set(WINGIT_DATA_DIRS assets models)
#     before the include() line.

include_guard(GLOBAL)

if(NOT DEFINED WINGIT_TARGET)
  set(WINGIT_TARGET wing_it)              # the game's add_executable() name
endif()
set(WINGIT_DISPLAY_NAME "Wing It")
set(WINGIT_BUNDLE_ID    "com.wingit.game")

set(_wingit_pkg_dir "${CMAKE_CURRENT_LIST_DIR}")
set(_wingit_gen_dir "${CMAKE_BINARY_DIR}/wingit_generated")
file(MAKE_DIRECTORY "${_wingit_gen_dir}")

if(NOT TARGET ${WINGIT_TARGET})
  message(FATAL_ERROR "packaging.cmake: no target named '${WINGIT_TARGET}'. "
                      "Include it after add_executable(), or set WINGIT_TARGET.")
endif()

# ---------------------------------------------------------------------------
# Logo built into the executable (packaging/logo.png -> logo_png.h)
# ---------------------------------------------------------------------------
file(READ "${_wingit_pkg_dir}/logo.png" _wingit_hex HEX)
string(LENGTH "${_wingit_hex}" _wingit_hex_len)
math(EXPR _wingit_byte_count "${_wingit_hex_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _wingit_bytes "${_wingit_hex}")
# Break the array into lines of 16 bytes so compilers don't choke on one huge line.
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 _wingit_line_regex)
string(REGEX REPLACE "(${_wingit_line_regex})" "\\1\n" _wingit_bytes "${_wingit_bytes}")
file(WRITE "${_wingit_gen_dir}/logo_png.h.tmp"
  "// Generated by packaging/packaging.cmake from packaging/logo.png. Do not edit.\n"
  "#pragma once\n"
  "static const unsigned char kLogoPng[${_wingit_byte_count}] = {\n${_wingit_bytes}};\n")
# Only touch the real header when the logo changed, so it doesn't trigger rebuilds.
configure_file("${_wingit_gen_dir}/logo_png.h.tmp" "${_wingit_gen_dir}/logo_png.h" COPYONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_wingit_pkg_dir}/logo.png")

# app_icon.cpp lives in src/ (picked up by the source glob) and app_icon.hpp in inc/.
target_include_directories(${WINGIT_TARGET} PRIVATE "${_wingit_gen_dir}")

# ---------------------------------------------------------------------------
# Windows: .exe icon, no console window in Release builds
# ---------------------------------------------------------------------------
if(WIN32)
  set(WINGIT_ICO_PATH "${_wingit_pkg_dir}/logo.ico")
  configure_file("${_wingit_pkg_dir}/wing_it.rc.in" "${_wingit_gen_dir}/wing_it.rc" @ONLY)
  target_sources(${WINGIT_TARGET} PRIVATE "${_wingit_gen_dir}/wing_it.rc")
endif()

if(MSVC)
  # Debug builds keep the console so printf output stays visible while developing.
  target_link_options(${WINGIT_TARGET} PRIVATE
    $<$<CONFIG:Release>:/SUBSYSTEM:WINDOWS>
    $<$<CONFIG:Release>:/ENTRY:mainCRTStartup>)
endif()

# ---------------------------------------------------------------------------
# What goes into the package (everything is in the "Game" component)
# ---------------------------------------------------------------------------
if(NOT DEFINED WINGIT_DATA_DIRS)
  set(WINGIT_DATA_DIRS "")
  foreach(_wingit_dir IN ITEMS assets resources res data)
    if(IS_DIRECTORY "${PROJECT_SOURCE_DIR}/${_wingit_dir}")
      list(APPEND WINGIT_DATA_DIRS "${_wingit_dir}")
    endif()
  endforeach()
endif()

if(APPLE)
  # A real .app bundle, assembled at package time. Local builds are untouched:
  # build/wing_it still runs from the terminal exactly as before.
  set(_wingit_app "${WINGIT_DISPLAY_NAME}.app")
  set(_wingit_data_dest "${_wingit_app}/Contents/Resources")

  configure_file("${_wingit_pkg_dir}/Info.plist.in" "${_wingit_gen_dir}/Info.plist" @ONLY)
  install(PROGRAMS "$<TARGET_FILE:${WINGIT_TARGET}>"
          DESTINATION "${_wingit_app}/Contents/MacOS" RENAME WingIt COMPONENT Game)
  install(FILES "${_wingit_gen_dir}/Info.plist"
          DESTINATION "${_wingit_app}/Contents" COMPONENT Game)
  install(FILES "${_wingit_pkg_dir}/logo.icns"
          DESTINATION "${_wingit_app}/Contents/Resources" COMPONENT Game)
elseif(WIN32)
  set(_wingit_data_dest ".")
  install(PROGRAMS "$<TARGET_FILE:${WINGIT_TARGET}>"
          DESTINATION "." RENAME "${WINGIT_DISPLAY_NAME}.exe" COMPONENT Game)
else()
  set(_wingit_data_dest ".")
  install(PROGRAMS "$<TARGET_FILE:${WINGIT_TARGET}>"
          DESTINATION "." RENAME WingIt COMPONENT Game)
endif()

foreach(_wingit_dir IN LISTS WINGIT_DATA_DIRS)
  install(DIRECTORY "${PROJECT_SOURCE_DIR}/${_wingit_dir}"
          DESTINATION "${_wingit_data_dest}" COMPONENT Game)
endforeach()

if(MSVC)
  # Ship the Visual C++ runtime and OpenMP DLLs next to the .exe, so players
  # don't need to install the Visual C++ Redistributable first.
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION ".")
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_COMPONENT Game)
  set(CMAKE_INSTALL_OPENMP_LIBRARIES TRUE)
  include(InstallRequiredSystemLibraries)
endif()

if(APPLE)
  # Runs while the package is being made, after the files above are in place:
  # copies Homebrew libraries the game links to (libomp) into the app, points the
  # executable at those copies, then signs the app so macOS will open it.
  set(_wingit_fixup [[
    set(_app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@_wingit_app@")
    set(_exe "${_app}/Contents/MacOS/WingIt")
    set(_fw  "${_app}/Contents/Frameworks")
    execute_process(COMMAND otool -L "${_exe}" OUTPUT_VARIABLE _deps COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "(/opt/homebrew|/usr/local)/[^ \t\r\n]+\\.dylib" _libs "${_deps}")
    foreach(_lib IN LISTS _libs)
      get_filename_component(_name "${_lib}" NAME)
      file(MAKE_DIRECTORY "${_fw}")
      execute_process(COMMAND cp -L "${_lib}" "${_fw}/${_name}" COMMAND_ERROR_IS_FATAL ANY)
      execute_process(COMMAND chmod u+w "${_fw}/${_name}" COMMAND_ERROR_IS_FATAL ANY)
      execute_process(COMMAND install_name_tool -id "@executable_path/../Frameworks/${_name}"
                              "${_fw}/${_name}" COMMAND_ERROR_IS_FATAL ANY)
      execute_process(COMMAND install_name_tool -change "${_lib}"
                              "@executable_path/../Frameworks/${_name}" "${_exe}"
                              COMMAND_ERROR_IS_FATAL ANY)
      message(STATUS "Bundled ${_name} into ${_app}")
    endforeach()
    # Ad-hoc signature: not an Apple developer ID, but required on Apple Silicon
    # after changing the executable, and it stops macOS calling the app "damaged".
    execute_process(COMMAND codesign --force --deep --sign - "${_app}" COMMAND_ERROR_IS_FATAL ANY)
  ]])
  string(CONFIGURE "${_wingit_fixup}" _wingit_fixup @ONLY)
  install(CODE "${_wingit_fixup}" COMPONENT Game)
endif()

# ---------------------------------------------------------------------------
# CPack: one archive per platform, game only
# ---------------------------------------------------------------------------
if(WIN32)
  set(_wingit_platform Windows)
elseif(APPLE)
  set(_wingit_platform macOS)
else()
  set(_wingit_platform Linux)
endif()

set(CPACK_PACKAGE_NAME      "WingIt")
set(CPACK_PACKAGE_VENDOR    "Wing It team")
set(CPACK_PACKAGE_FILE_NAME "WingIt-${_wingit_platform}")
set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)        # package by component...
set(CPACK_COMPONENTS_ALL Game)                 # ...and only the game's component
set(CPACK_COMPONENTS_GROUPING ALL_COMPONENTS_IN_ONE)
# Linux: the .tar.gz holds a WingIt-Linux/ folder (the usual convention).
# Windows and macOS: files sit at the top of the .zip, because Explorer and
# Finder already unzip into a folder of their own (macOS gives just "Wing It.app").
if(_wingit_platform STREQUAL "Linux")
  set(CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY ON)
else()
  set(CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY OFF)
endif()
include(CPack)
